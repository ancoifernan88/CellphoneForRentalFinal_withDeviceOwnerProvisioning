// =====================================================
// HTTP RESPONSE
// =====================================================

void sendHttpResponse(
  WiFiClient &client,
  int status,
  String contentType,
  String body
) {
  String statusText = "OK";

  if (status == 401) statusText = "Unauthorized";
  if (status == 403) statusText = "Forbidden";
  if (status == 404) statusText = "Not Found";
  if (status == 400) statusText = "Bad Request";
  if (status == 409) statusText = "Conflict";

  client.print("HTTP/1.1 ");
  client.print(status);
  client.print(" ");
  client.println(statusText);

  client.println("Connection: close");
  client.println("Cache-Control: no-store");
  client.println("Content-Type: " + contentType);
  client.print("Content-Length: ");
  client.println(body.length());
  client.println();

  client.print(body);
}

// =====================================================
// ADMIN SAVE HANDLER
// =====================================================

void handleSave(
  WiFiClient &client,
  String authorization,
  String body
) {
  if (!checkAdminAuth(authorization)) {
    sendHttpResponse(
      client,
      401,
      "text/plain",
      "Administrator authentication required."
    );
    return;
  }

  if (paymentActive) {
    sendHttpResponse(
      client,
      409,
      "text/plain",
      "Cannot change settings during an active payment. Try again after payment finishes."
    );
    return;
  }

  String newSSID = getFormValue(body, "ssid");
  String newWiFi = getFormValue(body, "wifi");
  String newAdmin = getFormValue(body, "admin");

  if (newSSID.length() < 1 || newSSID.length() > 32) {
    sendHttpResponse(
      client, 400, "text/plain",
      "SSID must contain 1 to 32 characters."
    );
    return;
  }

  if (newWiFi.length() < 8 || newWiFi.length() > 63) {
    sendHttpResponse(
      client, 400, "text/plain",
      "Wi-Fi password must contain 8 to 63 characters."
    );
    return;
  }

  if (newAdmin.length() > 0 &&
      (newAdmin.length() < 4 || newAdmin.length() > 32)) {
    sendHttpResponse(
      client, 400, "text/plain",
      "Admin password must contain 4 to 32 characters."
    );
    return;
  }

  memset(config.ssid, 0, sizeof(config.ssid));
  memset(config.wifiPassword, 0, sizeof(config.wifiPassword));

  strncpy(config.ssid, newSSID.c_str(), sizeof(config.ssid) - 1);
  strncpy(config.wifiPassword, newWiFi.c_str(),
          sizeof(config.wifiPassword) - 1);

  if (newAdmin.length() > 0) {
    memset(config.adminPassword, 0, sizeof(config.adminPassword));

    strncpy(config.adminPassword, newAdmin.c_str(),
            sizeof(config.adminPassword) - 1);
  }

  saveConfig();

  String response = R"rawliteral(
<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body style="font-family:Arial;text-align:center;padding:30px">
<h2>Settings Saved</h2>
<p>The ESP8266 will restart and apply the new Wi-Fi settings.</p>
<p>Reconnect using the new Wi-Fi name and password.</p>
</body>
</html>
)rawliteral";

  sendHttpResponse(client, 200, "text/html", response);

  restartPending = true;
  restartAt = millis() + 1500UL;
}

// =====================================================
// PORTAL HANDLER
// =====================================================

void handlePortal() {
  WiFiClient client = portalServer.available();

  if (!client) return;

  client.setTimeout(1500);

  String requestLine = client.readStringUntil('\n');
  requestLine.trim();

  if (requestLine.length() == 0) {
    client.stop();
    return;
  }

  String method = "";
  String path = "";

  int firstSpace = requestLine.indexOf(' ');
  int secondSpace = requestLine.indexOf(' ', firstSpace + 1);

  if (firstSpace > 0 && secondSpace > firstSpace) {
    method = requestLine.substring(0, firstSpace);
    path = requestLine.substring(firstSpace + 1, secondSpace);
  }

  String authorization = "";
  int contentLength = 0;

  // Read HTTP headers.
  while (client.connected()) {
    String header = client.readStringUntil('\n');
    header.trim();

    if (header.length() == 0) break;

    String lowerHeader = header;
    lowerHeader.toLowerCase();

    if (lowerHeader.startsWith("authorization:")) {
      authorization = header.substring(
        String("authorization:").length()
      );
      authorization.trim();
    }

    if (lowerHeader.startsWith("content-length:")) {
      int colon = header.indexOf(':');

      contentLength = header.substring(colon + 1).toInt();
    }
  }

  if (contentLength < 0 || contentLength > 512) {
    sendHttpResponse(
      client, 400, "text/plain", "Invalid request size."
    );
    client.stop();
    return;
  }

  // Read POST body.
  String body = "";

  if (method == "POST" && contentLength > 0) {
    unsigned long bodyStart = millis();

    while ((int)body.length() < contentLength &&
           millis() - bodyStart < 1500UL) {
      while (client.available() &&
             (int)body.length() < contentLength) {
        body += (char)client.read();
      }

      yield();
    }
  }

  // Remove query string from the path.
  int queryPosition = path.indexOf('?');

  if (queryPosition >= 0) {
    path = path.substring(0, queryPosition);
  }

  if (method == "GET" && path == "/") {
    sendHttpResponse(
      client, 200, "text/html", homePage()
    );
  }
  else if (method == "GET" && path == "/admin") {
    if (!checkAdminAuth(authorization)) {
      String page = "Administrator login required.";

      sendHttpResponse(
        client, 401, "text/plain", page
      );

      // Ask browser to display its login prompt.
      client.stop();
      return;
    }

    sendHttpResponse(
      client, 200, "text/html", adminPage()
    );
  }
  else if (method == "POST" && path == "/save") {
    handleSave(client, authorization, body);
  }
  else {
    sendHttpResponse(
      client, 404, "text/plain", "Page not found."
    );
  }

  delay(1);
  client.stop();
}

// =====================================================
// SETUP
// =====================================================

void setup() {
  Serial.begin(115200);
  delay(200);

  Serial.println();
  Serial.println("================================");
  Serial.println("ANGKOY CELLPHONE FOR RENT");
  Serial.println("ESP8266 STARTING");
  Serial.println("================================");

  // Lock coin slot at startup.
  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, RELAY_INACTIVE);

  // Coin input is active HIGH.
  // Use an external 10k pull-down if needed.
  pinMode(COIN_PIN, INPUT);

  attachInterrupt(
    digitalPinToInterrupt(COIN_PIN),
    coinPulseISR,
    RISING
  );

  noInterrupts();
  coinCountingEnabled = false;
  paymentPulseCount = 0;
  lastIsrPulseMicros = 0;
  interrupts();

  // Clear registration slots.
  for (byte i = 0; i < MAX_DEVICES; i++) {
    devices[i].phoneID = "";
    devices[i].ip = IPAddress(0, 0, 0, 0);
    devices[i].port = 0;
    devices[i].lastRequest = 0;
    devices[i].active = false;
  }

  loadConfig();

  // Start standalone access point.
  WiFi.mode(WIFI_AP);

  WiFi.softAPConfig(
    localIP,
    gateway,
    subnet
  );

  bool apStarted = WiFi.softAP(
    config.ssid,
    config.wifiPassword
  );

  if (apStarted) {
    Serial.println("Wi-Fi AP started.");
  } else {
    Serial.println("Wi-Fi AP failed to start!");
  }

  Serial.print("SSID: ");
  Serial.println(config.ssid);

  Serial.print("IP address: ");
  Serial.println(WiFi.softAPIP());

  // Start UDP service.
  udp.begin(UDP_PORT);

  Serial.print("UDP port: ");
  Serial.println(UDP_PORT);

  // Start public web portal.
  portalServer.begin();

  Serial.println("Portal started on port 80.");
  Serial.println("Admin username: admin");
  Serial.println("================================");
}

// =====================================================
// MAIN LOOP
// =====================================================

void loop() {
  checkCoinSlot();

  receiveCommands();

  checkPaymentTimeout();

  cleanupExpiredRegistrations();

  handlePortal();

  if (restartPending &&
      (long)(millis() - restartAt) >= 0) {
    ESP.restart();
  }

  yield();
}
