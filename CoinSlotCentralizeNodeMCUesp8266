/*
  ANGKOY CELLPHONE FOR RENT
  ESP8266 standalone Wi-Fi AP + coin slot + UDP payment controller

  Wi-Fi AP:
    SSID:     AngkoyCellphoneForRent
    Password: 00000000
    IP:       192.168.1.110

  UDP:
    Port: 8888

  Coin input:
    GPIO14 (D5), active HIGH, count on rising edge
    Use a 10k pull-down resistor if the coin output does not
    provide a defined LOW idle level.

  Relay:
    GPIO5 (D1), active LOW

  Payment protocol:
    REGISTER|phoneID|token
    PAY|phoneID|token

    REGISTERED|phoneID
    PAYMENT_GRANTED|transaction
    COIN_UPDATE|transaction|pulses|15
    ADD_PULSES|phoneID|pulses|transaction
    PAYMENT_COMPLETE|transaction|pulses
    PAYMENT_CANCELLED|transaction
*/

#include <ESP8266WiFi.h>
#include <WiFiUdp.h>
#include <EEPROM.h>

// =====================================================
// HARDWARE SETTINGS
// =====================================================

#define COIN_PIN 14       // D5
#define RELAY_PIN 5       // D1

#define RELAY_ACTIVE LOW
#define RELAY_INACTIVE HIGH

// =====================================================
// NETWORK SETTINGS
// =====================================================

IPAddress localIP(192, 168, 1, 110);
IPAddress gateway(192, 168, 1, 110);
IPAddress subnet(255, 255, 255, 0);

const unsigned int UDP_PORT = 8888;

WiFiUDP udp;
WiFiServer portalServer(80);

// Android app must use the same token.
const char DEVICE_TOKEN[] = "ANGKOY-CHANGE-ME";

// =====================================================
// DEFAULT PORTAL SETTINGS
// =====================================================

const char DEFAULT_SSID[] = "AngkoyCellphoneForRent";
const char DEFAULT_WIFI_PASSWORD[] = "00000000";
const char DEFAULT_ADMIN_PASSWORD[] = "2580";

const char ADMIN_USERNAME[] = "admin";

// =====================================================
// PAYMENT SETTINGS
// =====================================================

const byte MAX_DEVICES = 8;

const unsigned long PAYMENT_TIMEOUT_MS = 15000UL;
const unsigned long REGISTRATION_TIMEOUT_MS = 30000UL;
const unsigned long PAYMENT_COOLDOWN_MS = 5000UL;

// Coin pulse debounce.
// Your FAST setting is approximately 35ms HIGH + 35ms LOW.
// A 10ms debounce allows those pulses to be counted.
const unsigned long COIN_DEBOUNCE_US = 10000UL;

// =====================================================
// EEPROM CONFIGURATION
// =====================================================

#define EEPROM_SIZE 512
#define CONFIG_MAGIC 0xA67B

struct ConfigData {
  unsigned int magic;
  char ssid[33];
  char wifiPassword[64];
  char adminPassword[33];
};

ConfigData config;

// =====================================================
// PHONE REGISTRATION
// =====================================================

struct PhoneDevice {
  String phoneID;
  IPAddress ip;
  unsigned int port;
  unsigned long lastRequest;
  bool active;
};

PhoneDevice devices[MAX_DEVICES];

// =====================================================
// PAYMENT STATE
// =====================================================

bool paymentActive = false;

String paymentOwner = "";
String paymentTransaction = "";

IPAddress paymentIP;
unsigned int paymentPort = 0;

unsigned long paymentStartedAt = 0;
unsigned long lastCoinAt = 0;

unsigned long lastPaymentAt = 0;
bool paymentCooldownStarted = false;

unsigned long lastReportedPulses = 0;

// =====================================================
// COIN INTERRUPT VARIABLES
// =====================================================

volatile unsigned long paymentPulseCount = 0;
volatile unsigned long lastIsrPulseMicros = 0;
volatile bool coinCountingEnabled = false;

// =====================================================
// PORTAL RESTART
// =====================================================

bool restartPending = false;
unsigned long restartAt = 0;

// =====================================================
// COIN INTERRUPT
// =====================================================

ICACHE_RAM_ATTR void coinPulseISR() {
  if (!coinCountingEnabled) return;

  unsigned long now = micros();

  if (now - lastIsrPulseMicros >= COIN_DEBOUNCE_US) {
    paymentPulseCount++;
    lastIsrPulseMicros = now;
  }
}

// =====================================================
// EEPROM FUNCTIONS
// =====================================================

void loadConfig() {
  EEPROM.begin(EEPROM_SIZE);
  EEPROM.get(0, config);

  if (config.magic != CONFIG_MAGIC) {
    config.magic = CONFIG_MAGIC;

    memset(config.ssid, 0, sizeof(config.ssid));
    memset(config.wifiPassword, 0, sizeof(config.wifiPassword));
    memset(config.adminPassword, 0, sizeof(config.adminPassword));

    strncpy(config.ssid, DEFAULT_SSID, sizeof(config.ssid) - 1);
    strncpy(config.wifiPassword, DEFAULT_WIFI_PASSWORD,
            sizeof(config.wifiPassword) - 1);
    strncpy(config.adminPassword, DEFAULT_ADMIN_PASSWORD,
            sizeof(config.adminPassword) - 1);

    EEPROM.put(0, config);
    EEPROM.commit();
  }

  config.ssid[32] = '\0';
  config.wifiPassword[63] = '\0';
  config.adminPassword[32] = '\0';
}

void saveConfig() {
  config.magic = CONFIG_MAGIC;
  EEPROM.put(0, config);
  EEPROM.commit();
}

// =====================================================
// UDP SEND FUNCTIONS
// =====================================================

void sendUDP(IPAddress ip, unsigned int port, String message) {
  udp.beginPacket(ip, port);
  udp.write((const uint8_t*)message.c_str(), message.length());
  udp.endPacket();
}

void sendToPaymentOwner(String message) {
  if (paymentOwner.length() == 0) return;

  sendUDP(paymentIP, paymentPort, message);
}

// =====================================================
// PHONE REGISTRATION FUNCTIONS
// =====================================================

int findDevice(String phoneID) {
  for (byte i = 0; i < MAX_DEVICES; i++) {
    if (devices[i].active && devices[i].phoneID == phoneID) {
      return i;
    }
  }

  return -1;
}

void removeDevice(String phoneID) {
  int index = findDevice(phoneID);

  if (index < 0) return;

  devices[index].phoneID = "";
  devices[index].ip = IPAddress(0, 0, 0, 0);
  devices[index].port = 0;
  devices[index].lastRequest = 0;
  devices[index].active = false;

  Serial.println("Registration removed: " + phoneID);
}

void cleanupExpiredRegistrations() {
  unsigned long now = millis();

  for (byte i = 0; i < MAX_DEVICES; i++) {
    if (!devices[i].active) continue;

    // Never expire the phone currently making a payment.
    if (paymentActive &&
        devices[i].phoneID == paymentOwner) {
      continue;
    }

    if (now - devices[i].lastRequest >= REGISTRATION_TIMEOUT_MS) {
      String expiredID = devices[i].phoneID;
      removeDevice(expiredID);
    }
  }
}

void registerPhone(
  String phoneID,
  String token,
  IPAddress senderIP,
  unsigned int senderPort
) {
  if (token != DEVICE_TOKEN) {
    sendUDP(senderIP, senderPort, "INVALID_TOKEN");
    return;
  }

  if (phoneID.length() == 0 || phoneID.length() > 32) {
    sendUDP(senderIP, senderPort, "INVALID_PHONE_ID");
    return;
  }

  int index = findDevice(phoneID);

  // Refresh an existing registration.
  if (index >= 0) {
    devices[index].ip = senderIP;
    devices[index].port = senderPort;
    devices[index].lastRequest = millis();

    sendUDP(senderIP, senderPort,
            "REGISTERED|" + phoneID);

    return;
  }

  // Find an empty registration slot.
  for (byte i = 0; i < MAX_DEVICES; i++) {
    if (!devices[i].active) {
      devices[i].phoneID = phoneID;
      devices[i].ip = senderIP;
      devices[i].port = senderPort;
      devices[i].lastRequest = millis();
      devices[i].active = true;

      sendUDP(senderIP, senderPort,
              "REGISTERED|" + phoneID);

      Serial.println("Phone registered: " + phoneID);
      return;
    }
  }

  sendUDP(senderIP, senderPort, "REGISTRATION_FULL");
}

// =====================================================
// PAYMENT FUNCTIONS
// =====================================================

void startPayment(
  String phoneID,
  String token,
  IPAddress senderIP,
  unsigned int senderPort
) {
  if (token != DEVICE_TOKEN) {
    sendUDP(senderIP, senderPort, "INVALID_TOKEN");
    return;
  }

  int index = findDevice(phoneID);

  if (index < 0) {
    sendUDP(senderIP, senderPort, "NOT_REGISTERED");
    return;
  }

  if (devices[index].ip != senderIP) {
    sendUDP(senderIP, senderPort, "IP_MISMATCH");
    return;
  }

  // Handle a repeated PAY request from the phone
  // that is already paying.
  if (paymentActive && phoneID == paymentOwner) {
    sendUDP(senderIP, senderPort,
            "PAYMENT_GRANTED|" + paymentTransaction);
    return;
  }

  // Another phone is currently paying.
  if (paymentActive) {
    sendUDP(senderIP, senderPort,
            "PAYMENT_BUSY|" + paymentOwner);

    // This registration is no longer needed.
    removeDevice(phoneID);
    return;
  }

  // Enforce cooldown between payment sessions.
  if (paymentCooldownStarted &&
      millis() - lastPaymentAt < PAYMENT_COOLDOWN_MS) {
    sendUDP(senderIP, senderPort, "REQUEST_COOLDOWN");

    removeDevice(phoneID);
    return;
  }

  devices[index].port = senderPort;
  devices[index].lastRequest = millis();

  paymentOwner = phoneID;
  paymentIP = senderIP;
  paymentPort = senderPort;

  paymentTransaction = "TX" + String(millis());

  paymentStartedAt = millis();
  lastCoinAt = millis();

  noInterrupts();
  paymentPulseCount = 0;
  lastIsrPulseMicros = 0;
  coinCountingEnabled = true;
  interrupts();

  lastReportedPulses = 0;

  paymentActive = true;

  // Unlock the coin slot.
  digitalWrite(RELAY_PIN, RELAY_ACTIVE);

  sendToPaymentOwner(
    "PAYMENT_GRANTED|" + paymentTransaction
  );

  Serial.println("--------------------------------");
  Serial.println("PAYMENT STARTED");
  Serial.println("Phone: " + paymentOwner);
  Serial.println("Transaction: " + paymentTransaction);
  Serial.println("--------------------------------");
}

void finishPayment() {
  if (!paymentActive) return;

  // Stop pulse counting before reading the final count.
  noInterrupts();
  coinCountingEnabled = false;
  unsigned long finalPulses = paymentPulseCount;
  interrupts();

  String owner = paymentOwner;
  String transaction = paymentTransaction;

  Serial.println("--------------------------------");
  Serial.println("PAYMENT FINISHED");
  Serial.println("Phone: " + owner);
  Serial.println("Pulses: " + String(finalPulses));
  Serial.println("--------------------------------");

  if (finalPulses > 0) {
    // This is the final payment message Android should credit.
    sendToPaymentOwner(
      "ADD_PULSES|" +
      owner + "|" +
      String(finalPulses) + "|" +
      transaction
    );

    // Informational message only.
    sendToPaymentOwner(
      "PAYMENT_COMPLETE|" +
      transaction + "|" +
      String(finalPulses)
    );
  } else {
    sendToPaymentOwner(
      "PAYMENT_CANCELLED|" + transaction
    );
  }

  // Start cooldown.
  lastPaymentAt = millis();
  paymentCooldownStarted = true;

  // Clear payment state.
  paymentActive = false;

  // Automatically remove this phone's registration.
  removeDevice(owner);

  paymentOwner = "";
  paymentTransaction = "";
  paymentIP = IPAddress(0, 0, 0, 0);
  paymentPort = 0;

  lastReportedPulses = 0;

  // Lock the coin slot.
  digitalWrite(RELAY_PIN, RELAY_INACTIVE);
}

void checkCoinSlot() {
  if (!paymentActive) return;

  unsigned long currentPulses;

  noInterrupts();
  currentPulses = paymentPulseCount;
  interrupts();

  if (currentPulses != lastReportedPulses) {
    lastReportedPulses = currentPulses;
    lastCoinAt = millis();

    sendToPaymentOwner(
      "COIN_UPDATE|" +
      paymentTransaction + "|" +
      String(currentPulses) + "|15"
    );

    Serial.println("Coin pulses: " + String(currentPulses));
  }
}

void checkPaymentTimeout() {
  if (!paymentActive) return;

  if (millis() - lastCoinAt >= PAYMENT_TIMEOUT_MS) {
    finishPayment();
  }
}

// =====================================================
// UDP COMMAND PARSING
// =====================================================

String getField(String data, byte fieldNumber) {
  int start = 0;

  for (byte i = 0; i < fieldNumber; i++) {
    int separator = data.indexOf('|', start);

    if (separator < 0) return "";

    start = separator + 1;
  }

  int end = data.indexOf('|', start);

  if (end < 0) {
    return data.substring(start);
  }

  return data.substring(start, end);
}

void receiveCommands() {
  int packetSize = udp.parsePacket();

  if (packetSize <= 0) return;

  char packetBuffer[256];

  int len = udp.read(packetBuffer, sizeof(packetBuffer) - 1);

  if (len <= 0) return;

  packetBuffer[len] = '\0';

  String command = String(packetBuffer);
  command.trim();

  IPAddress senderIP = udp.remoteIP();
  unsigned int senderPort = udp.remotePort();

  String action = getField(command, 0);
  String phoneID = getField(command, 1);
  String token = getField(command, 2);

  Serial.println("UDP received: " + command);

  if (action == "REGISTER") {
    registerPhone(
      phoneID,
      token,
      senderIP,
      senderPort
    );
  }
  else if (action == "PAY") {
    startPayment(
      phoneID,
      token,
      senderIP,
      senderPort
    );
  }
}

// =====================================================
// BASIC AUTHENTICATION
// =====================================================

String base64Encode(String input) {
  const char table[] =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    "abcdefghijklmnopqrstuvwxyz"
    "0123456789+/";

  String output = "";
  int val = 0;
  int valb = -6;

  for (unsigned int i = 0; i < input.length(); i++) {
    val = (val << 8) + (unsigned char)input[i];
    valb += 8;

    while (valb >= 0) {
      output += table[(val >> valb) & 0x3F];
      valb -= 6;
    }
  }

  if (valb > -6) {
    output += table[((val << 8) >> (valb + 8)) & 0x3F];
  }

  while (output.length() % 4) {
    output += '=';
  }

  return output;
}

int base64Value(char c) {
  if (c >= 'A' && c <= 'Z') return c - 'A';
  if (c >= 'a' && c <= 'z') return c - 'a' + 26;
  if (c >= '0' && c <= '9') return c - '0' + 52;
  if (c == '+') return 62;
  if (c == '/') return 63;

  return -1;
}

String base64Decode(String input) {
  String output = "";
  int val = 0;
  int valb = -8;

  for (unsigned int i = 0; i < input.length(); i++) {
    int decoded = base64Value(input[i]);

    if (decoded < 0) continue;

    val = (val << 6) + decoded;
    valb += 6;

    if (valb >= 0) {
      output += char((val >> valb) & 0xFF);
      valb -= 8;
    }
  }

  return output;
}

bool checkAdminAuth(String authorization) {
  String expected = "Basic " +
    base64Encode(
      String(ADMIN_USERNAME) + ":" +
      String(config.adminPassword)
    );

  return authorization == expected;
}

// =====================================================
// URL DECODING
// =====================================================

String urlDecode(String input) {
  String output = "";

  for (unsigned int i = 0; i < input.length(); i++) {
    char c = input[i];

    if (c == '+') {
      output += ' ';
    }
    else if (c == '%' && i + 2 < input.length()) {
      char hex[3];

      hex[0] = input[i + 1];
      hex[1] = input[i + 2];
      hex[2] = '\0';

      output += (char)strtol(hex, NULL, 16);
      i += 2;
    }
    else {
      output += c;
    }
  }

  return output;
}

String getFormValue(String body, String key) {
  String search = key + "=";

  int start = body.indexOf(search);

  if (start < 0) return "";

  start += search.length();

  int end = body.indexOf('&', start);

  if (end < 0) {
    end = body.length();
  }

  return urlDecode(body.substring(start, end));
}

